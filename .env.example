# Copy to .env and fill in.

# Contact address appended to the scraper User-Agent and used as the OpenAlex `mailto`.
# Optional for scraping; strongly recommended for OpenAlex (Step 2).
CONTACT_EMAIL=

# Free OpenAlex API key (https://openalex.org/settings/api). Without it the shared keyless budget is
# $0.10/day per IP (~100 author searches); a free key gives $1/day, enough for a full refresh.
OPENALEX_API_KEY=

# SQLite path for the MVP.
DATABASE_PATH=data/research_match.db
